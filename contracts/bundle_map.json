{
  "$comment": "The one map from every file of the package bundle (blueprint 9.1) to the contract that validates it, read by tools/validate_bundle.py, harness/g1.py and the application's G1 (src/gates/g1.ts). `schema` is a file of this directory, `def` a member of its $defs (the item type of an array root, the type of an object root), `pointer` a JSON pointer into the schema when the type is a registry block rather than a $def, `properties` the typed keys of an object root that carries several 9.x types (an extra key listed with def null is an untyped list the validator only requires to be an array). `seed_time` files are produced where the corpus exists and are excluded from the public release (D-17); `optional` files may be absent; `required_from` names the bundle_version from which a file must exist (the sequencing decision of .crown/notes.md).",
  "contracts_dir": "contracts",
  "span_ordinals": "start_ordinal and end_ordinal of a Span are character offsets into the canonical page text (harness.documents); a workbook page is its Excel row number",
  "files": {
    "manifest.json": {"format": "json", "root": "object", "schema": "bundle/manifest.schema.json", "def": "Manifest"},
    "inventory.json": {"format": "json", "root": "object", "schema": "fixtures.schema.json", "pointer": "#/properties/inventory", "note": "the 10.5 inventory block plus `files`: one entry per corpus file (document_id, source_path, class, sha256, bytes, page_count, sidecar_path, text_extracted)"},
    "fixtures.json": {"format": "json", "root": "object", "schema": "fixtures.schema.json", "pointer": "#", "note": "a copy of packages/fixtures.json"},
    "documents.json": {"format": "json", "root": "array", "schema": "entities/document.schema.json", "def": "Document"},
    "revisions.json": {"format": "json", "root": "array", "schema": "entities/document.schema.json", "def": "DocumentRevision"},
    "claims.json": {"format": "json", "root": "object", "schema": "entities/document.schema.json", "properties": {"spans": {"root": "array", "def": "Span"}, "claims": {"root": "array", "def": "Claim"}, "edges": {"root": "array", "def": "DocumentEdge"}, "unresolved_references": {"root": "array", "def": null}}, "note": "spans at citation length only; edges resolve or are raised in unresolved_references"},
    "chunks.jsonl": {"format": "jsonl", "root": "lines", "schema": "entities/document.schema.json", "def": "Chunk", "seed_time": true},
    "interlocks.json": {"format": "json", "root": "object", "schema": "entities/asset.schema.json", "properties": {"equipment": {"root": "array", "def": "Equipment"}, "interlocks": {"root": "array", "def": "Interlock"}, "rows": {"root": "array", "def": "InterlockRow"}, "permissives": {"root": "array", "def": "StartPermissive"}, "instrument_tags": {"root": "array", "def": "InstrumentTag"}}, "note": "the asset and safety graph of 9.3; StartPermissive.seq_id is the sheet key (LOGIC No, or the equipment tag of a control-loop-only sheet)"},
    "datasheet_params.json": {"format": "json", "root": "array", "schema": "entities/asset.schema.json", "def": "DatasheetParam"},
    "datasheet_spot.json": {"format": "json", "root": "array", "schema": "entities/asset.schema.json", "def": "DatasheetParam", "note": "24 pinned spot values, 3 per asset, group datasheet_spot; the pinned quote is the span anchor G1 re-extracts"},
    "revision_spot.json": {"format": "json", "root": "array", "schema": "entities/document.schema.json", "def": "DocumentRevision", "note": "the current revision of each typed class per asset (datasheet, ga_drawing, plot_plan, interlock, pid): 40 pins"},
    "pid_sidecars/set_01.json": {"format": "json", "root": "object", "schema": "entities/asset.schema.json", "def": "PidSidecar"},
    "pid_sidecars/set_02.json": {"format": "json", "root": "object", "schema": "entities/asset.schema.json", "def": "PidSidecar"},
    "pid_sidecars/set_03.json": {"format": "json", "root": "object", "schema": "entities/asset.schema.json", "def": "PidSidecar"},
    "pid_sidecars/set_04.json": {"format": "json", "root": "object", "schema": "entities/asset.schema.json", "def": "PidSidecar"},
    "pid_sidecars/set_05.json": {"format": "json", "root": "object", "schema": "entities/asset.schema.json", "def": "PidSidecar"},
    "pid_sidecars/set_06.json": {"format": "json", "root": "object", "schema": "entities/asset.schema.json", "def": "PidSidecar"},
    "pid_sidecars/set_07.json": {"format": "json", "root": "object", "schema": "entities/asset.schema.json", "def": "PidSidecar"},
    "pid_sidecars/set_08.json": {"format": "json", "root": "object", "schema": "entities/asset.schema.json", "def": "PidSidecar"},
    "hand_verified.json": {"format": "json", "root": "object", "schema": null, "note": "the adopted P&ID readings (packages/hand_verified.json) relabelled basis agent_transcription, review_status pending (D-12); each set entry carries the document_id of its PNG beside `file`; no section 9 type"},
    "work_orders.json": {"format": "json", "root": "array", "schema": "entities/operations.schema.json", "def": "WorkOrder"},
    "failure_events.json": {"format": "json", "root": "array", "schema": "entities/operations.schema.json", "def": "FailureEvent"},
    "families.json": {"format": "json", "root": "array", "schema": "entities/operations.schema.json", "def": "FailureFamily"},
    "chains.json": {"format": "json", "root": "array", "schema": "entities/operations.schema.json", "def": "CausalLink"},
    "coverage_scores.json": {"format": "json", "root": "object", "schema": "entities/coverage.schema.json", "properties": {"method": {"root": "object", "def": "CoverageMethod"}, "assessments": {"root": "array", "def": "CoverageAssessment"}, "summaries": {"root": "array", "def": "CoverageSummary"}}},
    "coverage_labels.json": {"format": "json", "root": "object", "schema": "fixtures.schema.json", "pointer": "#/properties/coverage_labels", "note": "the 10.5 coverage_labels block plus `records`: the adjudicated label file with both labeller verdicts per record"},
    "adjudication_log.md": {"format": "markdown", "root": "text", "schema": null},
    "debt.json": {"format": "json", "root": "array", "schema": "entities/coverage.schema.json", "def": "DebtCluster"},
    "proof_tests.json": {"format": "json", "root": "array", "schema": "entities/operations.schema.json", "def": "ProofTest"},
    "integrity_findings.json": {"format": "json", "root": "object", "schema": "fixtures.schema.json", "pointer": "#/properties/integrity", "note": "the 10.5 integrity block plus `findings`: one row per register item (id, rule_id, rule, severity, discipline, observation_only, unit, basis, document_id, span_id, state, safety_function, routing_recommendation, item)"},
    "area_aliases.json": {"format": "json", "root": "array", "schema": "entities/asset.schema.json", "def": "Area"},
    "bom.json": {"format": "json", "root": "object", "schema": "entities/operations.schema.json", "properties": {"items": {"root": "array", "def": "BomItem"}, "matches": {"root": "array", "def": "BomMatch"}}},
    "opls.json": {"format": "json", "root": "object", "schema": "entities/coverage.schema.json", "properties": {"lessons": {"root": "array", "def": "Opl"}, "steps": {"root": "array", "def": "OplStep"}, "troubleshooting_rows": {"root": "array", "def": "TroubleshootingRow"}}, "seed_time": true, "note": "corpus text (sections 1 to 6): listed in the manifest, excluded from the release (D-17)"},
    "simulated/ga-1201a.json": {"format": "json", "root": "object", "schema": null, "optional": true, "note": "POLISH; provenance SIMULATED"},
    "rulepack/v1.json": {"format": "json", "root": "object", "schema": "rulepack.schema.json", "def": "RulePack"},
    "golden/cases.yaml": {"format": "yaml", "root": "array", "schema": "golden_case.schema.json", "def": "GoldenCase"},
    "contracts/edms.schema.json": {"format": "json_schema", "root": "object", "schema": "connectors/edms.schema.json", "note": "byte copy of the contract"},
    "contracts/aims.schema.json": {"format": "json_schema", "root": "object", "schema": "connectors/aims.schema.json", "note": "byte copy of the contract"},
    "contracts/historian.schema.json": {"format": "json_schema", "root": "object", "schema": "connectors/historian.schema.json", "note": "byte copy of the contract"},
    "seeded/packets.json": {"format": "json", "root": "array", "schema": "evidence_packet.schema.json", "def": "EvidencePacket", "required_from": "1.1.0"},
    "seeded/drafts.json": {"format": "json", "root": "array", "schema": "entities/drafts.schema.json", "def": "DraftDocument", "required_from": "1.1.0"},
    "seeded/traces.json": {"format": "json", "root": "array", "schema": "entities/serving.schema.json", "def": "AnswerTrace", "required_from": "1.1.0"}
  },
  "prefixes": {
    "pages/": {"format": "binary", "seed_time": true, "note": "metadata-free page derivatives, one width (1200 px, WebP); listed in the manifest, excluded from the release"},
    "text/": {"format": "text", "seed_time": true, "note": "extracted text; listed in the manifest, excluded from the release; not produced at bundle 1.0.0 (G1 re-extracts from the corpus)"}
  }
}
